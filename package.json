{
  "name": "multiscale-pathway-viewer",
  "version": "0.1.0",
  "description": "Expand and fold Reactome pathway hierarchies in Cytoscape Web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "cyweb": {
    "id": "multiscalePathwayViewer",
    "displayName": "Multiscale Pathway Viewer",
    "port": 6601
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:zip": "cross-env CYWEB_APP_ZIP=1 vite build",
    "verify": "cyweb-app verify",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cytoscape-web/api-types": "1.0.0-beta.3",
    "@cytoscape-web/app-runtime": "^0.3.0",
    "cross-env": "^10.1.0",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@mui/material": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@module-federation/vite": "1.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.2",
    "vite": "8.0.13",
    "vitest": "^4.1.8"
  }
}
